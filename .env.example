# Postgres. En producción, la cadena del proveedor (Neon, Supabase, RDS…) con
# sslmode=require y region en la UE. Sin esta variable, en desarrollo se usa
# PGlite —Postgres compilado a WASM— contra la carpeta .pgdata.
DATABASE_URL=

# Clave para firmar y cifrar. 32 bytes en hex:  openssl rand -hex 32
SECRETO=

# Correo del único usuario que se crea al sembrar la base.
ADMIN_EMAIL=
ADMIN_CLAVE=
